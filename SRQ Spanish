<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SRQ Spanish Trivia | Calusa Brewing</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-20 selection:bg-amber-500 selection:text-slate-900">

  <!-- Header -->
  <header class="bg-gradient-to-r from-amber-600 via-orange-600 to-rose-600 px-4 py-6 shadow-lg sticky top-0 z-30">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div>
        <p class="text-xs uppercase tracking-widest font-extrabold text-amber-200">SRQ Spanish Social</p>
        <h1 class="text-xl font-black tracking-tight text-white">Noche de Trivia 🍻</h1>
      </div>
      <span class="bg-black/30 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-amber-200 border border-white/10">
        Calusa Brewing
      </span>
    </div>
  </header>

  <!-- Navigation Tabs -->
  <nav class="max-w-md mx-auto px-4 mt-4">
    <div class="flex bg-slate-900 p-1 rounded-xl border border-slate-800 text-xs font-bold">
      <button onclick="switchTab('trivia')" id="tab-trivia" class="flex-1 py-2 rounded-lg bg-amber-500 text-slate-950 shadow transition-all">
        Trivia
      </button>
      <button onclick="switchTab('answers')" id="tab-answers" class="flex-1 py-2 rounded-lg text-slate-400 hover:text-white transition-all">
        Respuestas
      </button>
      <button onclick="switchTab('info')" id="tab-info" class="flex-1 py-2 rounded-lg text-slate-400 hover:text-white transition-all">
        Programa & Guía
      </button>
    </div>
  </nav>

  <!-- Main Content Container -->
  <main class="max-w-md mx-auto px-4 mt-5 space-y-4">

    <!-- TAB 1: TRIVIA QUESTIONS -->
    <section id="section-trivia" class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider">Preguntas de la Noche</h2>
        <span class="text-xs text-amber-400 font-semibold">Toca cada tarjeta para ver pistas</span>
      </div>

      <!-- Ronda 1 -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
          <h3 class="font-bold text-amber-400 text-base">Ronda 1: Sarasota y la Costa del Golfo</h3>
          <span class="text-[10px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/20">6 Pts</span>
        </div>
        <div class="space-y-3" id="ronda1-list"></div>
      </div>

      <!-- Ronda 2 -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
          <h3 class="font-bold text-orange-400 text-base">Ronda 2: Cultura y Gastronomía</h3>
          <span class="text-[10px] bg-orange-500/10 text-orange-300 px-2 py-0.5 rounded-full border border-orange-500/20">6 Pts</span>
        </div>
        <div class="space-y-3" id="ronda2-list"></div>
      </div>

      <!-- Ronda 3 -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
          <h3 class="font-bold text-rose-400 text-base">Ronda 3: Modismos y Desafío</h3>
          <span class="text-[10px] bg-rose-500/10 text-rose-300 px-2 py-0.5 rounded-full border border-rose-500/20">6 Pts</span>
        </div>
        <div class="space-y-3" id="ronda3-list"></div>
      </div>
    </section>

    <!-- TAB 2: DIGITAL ANSWER SUBMISSION -->
    <section id="section-answers" class="hidden space-y-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
        <div>
          <h2 class="font-bold text-lg text-white">Hoja de Respuestas del Equipo</h2>
          <p class="text-xs text-slate-400">Escriban sus respuestas aquí para enviarlas o revisarlas al final de cada ronda.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Nombre del Equipo:</label>
          <input type="text" id="teamName" placeholder="Ej: Los Cerveceros de Sarasota" 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Seleccionar Ronda:</label>
          <select id="selectedRound" onchange="renderAnswerInputs()" 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
            <option value="1">Ronda 1: Sarasota y Costa del Golfo</option>
            <option value="2">Ronda 2: Cultura y Gastronomía</option>
            <option value="3">Ronda 3: Modismos y Desafío</option>
          </select>
        </div>

        <div id="answerInputsContainer" class="space-y-3 pt-2"></div>

        <button onclick="copyAnswers()" 
          class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded-xl transition flex items-center justify-center gap-2 text-sm">
          <span>📋</span> Copiar Respuestas al Portapapeles
        </button>
        <p id="copyStatus" class="text-center text-xs text-emerald-400 font-semibold hidden">¡Respuestas copiadas exitosamente!</p>
      </div>
    </section>

    <!-- TAB 3: SCHEDULE & VOCABULARY -->
    <section id="section-info" class="hidden space-y-4">
      <!-- Schedule -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
        <h3 class="font-bold text-amber-400 text-sm uppercase tracking-wider">Cronograma del Evento</h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between border-b border-slate-800/60 pb-1.5">
            <span class="text-slate-400 font-medium">6:30 PM – 6:50 PM</span>
            <span class="text-slate-200">Llegada, cervezas y armado de equipos</span>
          </div>
          <div class="flex justify-between border-b border-slate-800/60 pb-1.5">
            <span class="text-slate-400 font-medium">6:50 PM – 7:00 PM</span>
            <span class="text-slate-200">Explicación de reglas</span>
          </div>
          <div class="flex justify-between border-b border-slate-800/60 pb-1.5">
            <span class="text-slate-400 font-medium">7:00 PM – 8:15 PM</span>
            <span class="text-slate-200">Rondas de trivia (1, 2 y 3)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400 font-medium">8:15 PM – 8:30 PM</span>
            <span class="text-slate-200">Resultados, premios y charla libre</span>
          </div>
        </div>
      </div>

      <!-- Quick Vocabulary for Calusa Brewing -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
        <h3 class="font-bold text-emerald-400 text-sm uppercase tracking-wider">Vocabulario Útil en el Bar</h3>
        <ul class="space-y-2 text-xs text-slate-300">
          <li class="p-2 rounded-lg bg-slate-950 border border-slate-800/60">
            <strong class="text-white block">¿Qué cerveza me recomiendas?</strong>
            <span class="text-slate-500">What beer do you recommend?</span>
          </li>
          <li class="p-2 rounded-lg bg-slate-950 border border-slate-800/60">
            <strong class="text-white block">Una IPA / cerveza rubia / oscura, por favor.</strong>
            <span class="text-slate-500">An IPA / blonde / dark beer, please.</span>
          </li>
          <li class="p-2 rounded-lg bg-slate-950 border border-slate-800/60">
            <strong class="text-white block">¿Podemos pedir comida del food truck?</strong>
            <span class="text-slate-500">Can we order food from the food truck?</span>
          </li>
          <li class="p-2 rounded-lg bg-slate-950 border border-slate-800/60">
            <strong class="text-white block">¡Salud a todos!</strong>
            <span class="text-slate-500">Cheers to everyone!</span>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <!-- Script logic -->
  <script>
    const questionsData = {
      1: [
        { q: "¿Cómo se llama el magnate del circo que estableció la sede de invierno de su espectáculo en Sarasota en 1927?", hint: "Circus magnate who shaped Sarasota." },
        { q: "¿Cuál es el nombre del parque estatal en Sarasota conocido por su pasarela sobre las copas de los árboles y su río?", hint: "Famous state park with a canopy walkway." },
        { q: "¿Qué cuerpo de agua baña las playas de Siesta Key y Lido Beach?", hint: "Body of water bordering Florida's west coast." },
        { q: "¿Qué fruta cítrica es el símbolo oficial del estado de Florida?", hint: "State fruit of Florida." },
        { q: "¿Cuál fue la primera ciudad fundada por españoles en lo que hoy es EE. UU. continental en 1565?", hint: "Oldest continuously inhabited European city in the US." },
        { q: "Traduce al español: 'The sand on Siesta Beach is made of 99% pure quartz.'", hint: "Translate this iconic Sarasota fact into Spanish." }
      ],
      2: [
        { q: "¿Cuál es la capital de Perú, conocida históricamente como la «Ciudad de los Reyes»?", hint: "Peruvian coastal capital." },
        { q: "¿Qué plato típico mexicano consiste en una salsa compleja de chiles secos, especias y chocolate amargo?", hint: "Traditional rich Mexican savory sauce." },
        { q: "¿Quién escribió la célebre novela 'Cien años de soledad', publicada en 1967?", hint: "Colombian Nobel laureate author." },
        { q: "¿Qué país sudamericano tiene dos capitales oficiales (Sucre y La Paz)?", hint: "Landlocked South American nation." },
        { q: "¿Qué instrumento de percusión de origen afroperuano con forma de caja de madera se usa en el flamenco?", hint: "Box-shaped wooden percussion instrument." },
        { q: "¿Cuál es el ingrediente base que 'cocina' el pescado por ácido en un ceviche tradicional?", hint: "Citrus juice component." }
      ],
      3: [
        { q: "En México y Centroamérica, si alguien dice que algo está «chido» o «padre», ¿qué significa?", hint: "Slang for cool / great." },
        { q: "¿Qué significa la expresión española «estar como una cabra»?", hint: "Idiomatic expression related to acting eccentric." },
        { q: "¿En qué país sudamericano se utiliza habitualmente la palabra «che» para llamar a un amigo?", hint: "Tango country." },
        { q: "¿Verdadero o Falso? El español es el 2° idioma nativo más hablado del mundo, detrás del mandarín.", hint: "True or False demographic fact." },
        { q: "¿Cómo se llama la marca ortográfica que lleva la letra «ñ» encima?", hint: "Name of the tilde symbol on the letter ñ." },
        { q: "Si en Colombia te dicen de «hacer una vaca», ¿qué van a hacer?", hint: "Group pooling money together." }
      ]
    };

    function renderQuestions() {
      [1, 2, 3].forEach(round => {
        const container = document.getElementById(`ronda${round}-list`);
        container.innerHTML = questionsData[round].map((item, idx) => `
          <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800 text-xs space-y-1">
            <div class="flex gap-2">
              <span class="font-bold text-amber-500">${idx + 1}.</span>
              <p class="font-medium text-slate-200">${item.q}</p>
            </div>
            <details class="text-[11px] text-slate-500 pt-1 cursor-pointer">
              <summary class="hover:text-slate-400">Ver pista en inglés</summary>
              <p class="mt-1 pl-2 text-slate-400 italic">${item.hint}</p>
            </details>
          </div>
        `).join('');
      });
    }

    function renderAnswerInputs() {
      const round = document.getElementById('selectedRound').value;
      const container = document.getElementById('answerInputsContainer');
      container.innerHTML = questionsData[round].map((_, idx) => `
        <div>
          <label class="block text-[11px] text-slate-400 font-semibold mb-1">Pregunta ${idx + 1}:</label>
          <input type="text" id="ans-${round}-${idx + 1}" placeholder="Escribe la respuesta aquí..." 
            class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
        </div>
      `).join('');
    }

    function copyAnswers() {
      const team = document.getElementById('teamName').value.trim() || 'Equipo Sin Nombre';
      const round = document.getElementById('selectedRound').value;
      let text = `🏆 ${team} - Ronda ${round}\n`;
      questionsData[round].forEach((_, idx) => {
        const val = document.getElementById(`ans-${round}-${idx + 1}`)?.value || '(Sin responder)';
        text += `${idx + 1}. ${val}\n`;
      });

      navigator.clipboard.writeText(text).then(() => {
        const status = document.getElementById('copyStatus');
        status.classList.remove('hidden');
        setTimeout(() => status.classList.add('hidden'), 3500);
      });
    }

    function switchTab(tab) {
      ['trivia', 'answers', 'info'].forEach(t => {
        document.getElementById(`section-${t}`).classList.add('hidden');
        document.getElementById(`tab-${t}`).className = 'flex-1 py-2 rounded-lg text-slate-400 hover:text-white transition-all';
      });
      document.getElementById(`section-${tab}`).classList.remove('hidden');
      document.getElementById(`tab-${tab}`).className = 'flex-1 py-2 rounded-lg bg-amber-500 text-slate-950 font-bold shadow transition-all';
    }

    // Initialize
    renderQuestions();
    renderAnswerInputs();
  </script>
</body>
</html>
